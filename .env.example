# Copia este archivo a .env (no se versiona) y cárgalo antes de ejecutar:
#   Linux/macOS:  set -a; . ./.env; set +a
# Ver README → "Configurar OAuth".

# Google Cloud Console → Credenciales → ID de cliente OAuth tipo "App de escritorio"
CORNAMUSA_GOOGLE_CLIENT_ID=
# Los clientes de escritorio de Google incluyen un "secreto" que no es confidencial.
CORNAMUSA_GOOGLE_CLIENT_SECRET=

# Microsoft Entra (Azure) → Registros de aplicaciones → ID de aplicación (cliente)
CORNAMUSA_MS_CLIENT_ID=

# Opcional: CA extra (PEM) para servidores IMAP/SMTP propios con certificado privado.
# CORNAMUSA_EXTRA_CA=/ruta/a/ca.pem
